{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yougotmail",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yougotmail",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "yougotmail-files" }],
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "yougotmail-jobs" }],
    "consumers": [
      {
        "queue": "yougotmail-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "yougotmail-dead",
      },
      { "queue": "yougotmail-dead", "max_batch_size": 5, "max_retries": 3 },
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "MailboxLive" },
      { "name": "LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MailboxLive", "RateLimiter"] },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "secrets": { "required": ["SETUP_TOKEN", "APP_KEY"] },
  "vars": { "WORKER_NAME": "yougotmail" },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "limits": { "cpu_ms": 30000 },
}
