{
  "name": "yougotmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run db:remote && wrangler deploy",
    "preview": "vite preview --host 127.0.0.1",
    "seed": "node scripts/seed.mjs",
    "generate-secrets": "node scripts/secrets.mjs",
    "setup:local": "node scripts/init-local.mjs",
    "deploy:button": "node scripts/deploy-button.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Your unique setup key (at least 32 characters). Keep it to unlock first-run setup. Generate locally with npm run generate-secrets."
      },
      "APP_KEY": {
        "description": "A unique 32-byte base64 encryption key. Back it up securely; losing it makes saved integration credentials unreadable."
      },
      "DB": {
        "description": "Mailbox metadata and accounts."
      },
      "FILES": {
        "description": "Private email bodies, attachments, and branding."
      },
      "JOBS": {
        "description": "Reliable mail processing and sending."
      }
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "mimetext": "^3.0.28",
    "otpauth": "^9.5.2",
    "postal-mime": "^4.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
